# ============================================================
# Robô de arbitragem Bybit <-> Binance — configuração
# Copia para .env e preenche. NUNCA partilhes este ficheiro.
# ============================================================

# ---------- Modo ----------
# Sem LIVE=true o robô corre em DRY-RUN: lê preços reais, calcula e regista
# o que faria, mas NÃO coloca ordens. Só passa a live com `npm run live`.
# LIVE=false
# DEMO_TRADING=true usa as contas demo (api-demo.bybit.com / demo.binance.com) —
# precisa de chaves criadas nas contas demo. Ótimo para testar a execução real sem risco.
DEMO_TRADING=false
LOG_LEVEL=info
DATA_DIR=./data

# ---------- Exchanges ativas ----------
# bybit,binance = arbitragem cross-exchange (spot + funding) + cash-and-carry
# bybit         = só cash-and-carry na Bybit (spot/funding cross-exchange ficam desativados)
EXCHANGES=bybit,binance

# ---------- Chaves API ----------
# Permissões: só "Spot Trading" + "Derivatives/Futures Trading" + leitura.
# NUNCA ativar "Withdraw". Ativar restrição por IP (whitelist) com o IP da máquina onde corre o robô.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---------- Taxas (fração; 0.001 = 0.10%) ----------
# Confirma em "My Fee Rate" (Bybit) e "Fee Schedule" (Binance). Se pagares taxas com BNB na Binance:
# BINANCE_SPOT_TAKER_FEE=0.00075  BINANCE_SWAP_TAKER_FEE=0.00045
BYBIT_SPOT_MAKER_FEE=0.001
BYBIT_SPOT_TAKER_FEE=0.001
BYBIT_SWAP_MAKER_FEE=0.0002
BYBIT_SWAP_TAKER_FEE=0.00055
BINANCE_SPOT_MAKER_FEE=0.001
BINANCE_SPOT_TAKER_FEE=0.001
BINANCE_SWAP_MAKER_FEE=0.0002
BINANCE_SWAP_TAKER_FEE=0.0005

# ---------- Estratégia 1: arbitragem SPOT cross-exchange ----------
# Requer USDT em ambas as exchanges E a moeda em ambas (pré-financiado; não há transferências).
SPOT_ARB_ENABLED=true
SPOT_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,XRP/USDT,DOGE/USDT,ADA/USDT,AVAX/USDT,LINK/USDT,DOT/USDT,LTC/USDT,TON/USDT,SUI/USDT,APT/USDT,ARB/USDT,OP/USDT,NEAR/USDT,PEPE/USDT,WIF/USDT,TIA/USDT,SEI/USDT
SPOT_TRADE_USD=50
# lucro líquido mínimo (após taxas e margem de slippage) para executar
SPOT_MIN_NET_PCT=0.15
SPOT_MIN_NET_USD=0.05
SPOT_SLIPPAGE_BUFFER_PCT=0.03
SPOT_POLL_MS=1500
# spreads acima disto são considerados erro de dados
SPOT_MAX_SPREAD_PCT=3
SPOT_IOC_TOL_PCT=0.05
SPOT_LEG_MISMATCH_TOL_PCT=2
SPOT_SYMBOL_COOLDOWN_MS=10000

# ---------- Estratégia 2: arbitragem de FUNDING (perp vs perp, delta-neutro) ----------
# Requer USDT na conta de derivados de ambas as exchanges.
FUNDING_ARB_ENABLED=true
# vazio = todos os perps USDT comuns às duas; ou lista: BTC/USDT:USDT,ETH/USDT:USDT
FUNDING_SYMBOLS=
FUNDING_POSITION_USD=100
FUNDING_LEVERAGE=2
# spread de funding (normalizado a 8h) mínimo para abrir: 0.01% = ~11% APR bruto
FUNDING_MIN_SPREAD_8H_PCT=0.01
FUNDING_MIN_NET_APR_PCT=15
# fechar quando o spread cai abaixo disto durante N verificações seguidas
FUNDING_EXIT_SPREAD_8H_PCT=0.002
FUNDING_EXIT_CONFIRMATIONS=3
FUNDING_MAX_HOLD_HOURS=72
FUNDING_EXPECTED_HOLD_HOURS=24
FUNDING_MAX_BASIS_PCT=0.1
FUNDING_MAX_OPEN_POSITIONS=3
FUNDING_POLL_MS=60000
# tentar entrar como maker (post-only) antes de cair para mercado — poupa ~60% em taxas
FUNDING_USE_MAKER_ENTRY=false
FUNDING_MIN_VOLUME_24H_USD=5000000
FUNDING_MARGIN_ALERT_RATIO=0.5
# só abrir a <= N minutos do próximo settlement da perna dominante (0 = sempre)
FUNDING_ENTRY_WINDOW_MIN=45
# não fechar por "spread desapareceu" antes de N horas (uma oscilação não paga 4 taxas)
FUNDING_MIN_HOLD_HOURS=8
# stop-loss de basis: fecha se o P&L de preço das pernas cair abaixo de -X% do notional
FUNDING_MAX_LEG_LOSS_PCT=0.6

# ---------- Estratégia 3: CASH-AND-CARRY numa só exchange (spot long + perp short) ----------
# Recebe o funding positivo do perp enquanto está coberto pelo spot. Não precisa de 2 exchanges.
CARRY_ENABLED=true
CARRY_EXCHANGE=bybit
# CARRY_SYMBOLS=SOL/USDT:USDT,DOGE/USDT:USDT   (vazio = todos os perps USDT com spot)
CARRY_POSITION_USD=50
CARRY_LEVERAGE=2
# funding mínimo (atual E média 24h) por 8h, em %
CARRY_MIN_RATE_8H_PCT=0.01
# APR líquido mínimo após 4 taxas e basis, em %
CARRY_MIN_NET_APR_PCT=12
CARRY_EXIT_RATE_8H_PCT=0.002
CARRY_EXIT_CONFIRMATIONS=3
CARRY_MIN_HOLD_HOURS=8
CARRY_MAX_HOLD_HOURS=168
CARRY_EXPECTED_HOLD_HOURS=48
# máximo que o perp pode estar ABAIXO do spot à entrada (custo de basis), em %
CARRY_MAX_BASIS_COST_PCT=0.1
CARRY_MAX_LEG_LOSS_PCT=0.6
CARRY_MAX_OPEN_POSITIONS=3
CARRY_POLL_MS=60000
CARRY_ENTRY_WINDOW_MIN=45
CARRY_TOP_N=8

# ---------- Filtros de qualidade (funding + carry) ----------
# Volume 24h e open interest mínimos (USD) nas DUAS pernas; posição máx. em % do OI
QUALITY_MIN_VOLUME_24H_USD=5000000
QUALITY_MIN_OPEN_INTEREST_USD=2000000
QUALITY_MAX_POSITION_OI_RATIO=0.001
# ignorar perps listados há menos de N dias (funding de lançamento não persiste)
QUALITY_MIN_LISTING_DAYS=14
# o funding tem de estar acima do mínimo em MÉDIA nas últimas N horas (não só agora)
QUALITY_PERSISTENCE_HOURS=24
QUALITY_MIN_HISTORY_PERIODS=3
QUALITY_REQUIRE_HISTORY=true
# nº máx. de mudanças de sinal do funding no período
QUALITY_MAX_SIGN_FLIPS=1
# QUALITY_BLACKLIST=LUNA,FTT

# ---------- Gestão de risco (circuit breakers) ----------
MAX_DAILY_LOSS_USD=10
MAX_OPEN_NOTIONAL_USD=500
MAX_CONSECUTIVE_FAILURES=3
STALE_DATA_MS=5000
KILL_SWITCH_FILE=./STOP
MAX_TRADES_PER_HOUR=30

# ---------- Painel web (opcional; obrigatório em hosting na nuvem) ----------
# PORT>0 liga um painel HTTP com P&L, posições, trades, /health e /api/status.
# WEB_TOKEN protege os botões Parar/Retomar: abre http://host:PORT/?token=<WEB_TOKEN>
PORT=8080
WEB_TOKEN=

# ---------- Alertas Telegram (opcional) ----------
# Cria um bot com @BotFather, obtém o chat_id com @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REPORT_EVERY_MIN=60
