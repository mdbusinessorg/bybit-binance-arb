# ============================================================
# Robô de arbitragem Bybit <-> Binance — configuração
# Copia para .env e preenche. NUNCA partilhes este ficheiro.
# ============================================================

# ---------- Modo ----------
# Sem LIVE=true o robô corre em DRY-RUN: lê preços reais, calcula e regista
# o que faria, mas NÃO coloca ordens. Só passa a live com `npm run live`.
# LIVE=false

# MANUAL_APPROVAL=true  → oportunidades validadas ficam pendentes no painel
# até o utilizador clicar EXECUTE (em vez de executar automaticamente)
# MANUAL_APPROVAL=false
# DEMO_TRADING=true usa as contas demo (api-demo.bybit.com / demo.binance.com) —
# precisa de chaves criadas nas contas demo. Ótimo para testar a execução real sem risco.
DEMO_TRADING=false
LOG_LEVEL=info
DATA_DIR=./data

# ---------- Exchanges ----------
# 2 ou mais, separadas por vírgula. Suportadas: bybit, binance, okx, kucoin
# Nota: OKX e KuCoin operam em regiões onde Bybit/Binance bloqueiam (e vice-versa).
EXCHANGES=bybit,binance

# ---------- Chaves API ----------
# Permissões: só "Spot Trading" + "Derivatives/Futures Trading" + leitura.
# NUNCA ativar "Withdraw". Ativar restrição por IP (whitelist) com o IP da máquina onde corre o robô.
# OKX e KuCoin exigem também a passphrase da API (*_API_PASSWORD).
BYBIT_API_KEY=
BYBIT_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSWORD=
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSWORD=

# ---------- Taxas (fração; 0.001 = 0.10%) ----------
# Confirma em "My Fee Rate" (Bybit) e "Fee Schedule" (Binance). Se pagares taxas com BNB na Binance:
# BINANCE_SPOT_TAKER_FEE=0.00075  BINANCE_SWAP_TAKER_FEE=0.00045
BYBIT_SPOT_MAKER_FEE=0.001
BYBIT_SPOT_TAKER_FEE=0.001
BYBIT_SWAP_MAKER_FEE=0.0002
BYBIT_SWAP_TAKER_FEE=0.00055
BINANCE_SPOT_MAKER_FEE=0.001
BINANCE_SPOT_TAKER_FEE=0.001
BINANCE_SWAP_MAKER_FEE=0.0002
BINANCE_SWAP_TAKER_FEE=0.0005
OKX_SPOT_MAKER_FEE=0.0008
OKX_SPOT_TAKER_FEE=0.001
OKX_SWAP_MAKER_FEE=0.0002
OKX_SWAP_TAKER_FEE=0.0005
KUCOIN_SPOT_MAKER_FEE=0.001
KUCOIN_SPOT_TAKER_FEE=0.001
KUCOIN_SWAP_MAKER_FEE=0.0002
KUCOIN_SWAP_TAKER_FEE=0.0006

# ---------- Estratégia 1: arbitragem SPOT cross-exchange ----------
# Requer USDT em ambas as exchanges E a moeda em ambas (pré-financiado; não há transferências).
SPOT_ARB_ENABLED=true
SPOT_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,XRP/USDT,DOGE/USDT,ADA/USDT,AVAX/USDT,LINK/USDT,DOT/USDT,LTC/USDT,TON/USDT,SUI/USDT,APT/USDT,ARB/USDT,OP/USDT,NEAR/USDT,PEPE/USDT,WIF/USDT,TIA/USDT,SEI/USDT
SPOT_TRADE_USD=50
# lucro líquido mínimo (após taxas e margem de slippage) para executar
SPOT_MIN_NET_PCT=0.15
SPOT_MIN_NET_USD=0.05
SPOT_SLIPPAGE_BUFFER_PCT=0.03
SPOT_POLL_MS=1500
# spreads acima disto são considerados erro de dados
SPOT_MAX_SPREAD_PCT=3
SPOT_IOC_TOL_PCT=0.05
SPOT_LEG_MISMATCH_TOL_PCT=2
SPOT_SYMBOL_COOLDOWN_MS=10000

# ---------- Estratégia 2: arbitragem de FUNDING (perp vs perp, delta-neutro) ----------
# Requer USDT na conta de derivados de ambas as exchanges.
FUNDING_ARB_ENABLED=true
# vazio = todos os perps USDT comuns às duas; ou lista: BTC/USDT:USDT,ETH/USDT:USDT
FUNDING_SYMBOLS=
FUNDING_POSITION_USD=100
FUNDING_LEVERAGE=2
# spread de funding (normalizado a 8h) mínimo para abrir: 0.01% = ~11% APR bruto
FUNDING_MIN_SPREAD_8H_PCT=0.01
FUNDING_MIN_NET_APR_PCT=15
# fechar quando o spread cai abaixo disto durante N verificações seguidas
FUNDING_EXIT_SPREAD_8H_PCT=0.002
FUNDING_EXIT_CONFIRMATIONS=3
FUNDING_MAX_HOLD_HOURS=72
FUNDING_EXPECTED_HOLD_HOURS=24
FUNDING_MAX_BASIS_PCT=0.1
FUNDING_MAX_OPEN_POSITIONS=3
FUNDING_POLL_MS=60000
# tentar entrar como maker (post-only) antes de cair para mercado — poupa ~60% em taxas
FUNDING_USE_MAKER_ENTRY=false
FUNDING_MIN_VOLUME_24H_USD=5000000
FUNDING_MARGIN_ALERT_RATIO=0.5

# ---------- Estratégia 3: arbitragem TRIANGULAR intra-exchange ----------
# USDT -> X -> BTC -> USDT (e inverso) numa exchange. 3 taxas taker por rota,
# margens muito finas — desativada por defeito.
TRI_ARB_ENABLED=false
# vazio = todas as bases com X/USDT + X/BTC + BTC/USDT; ou lista de bases: SOL,LINK,DOGE
TRI_SYMBOLS=
TRI_TRADE_USD=30
TRI_MIN_NET_PCT=0.12
TRI_MIN_NET_USD=0.03
TRI_SLIPPAGE_BUFFER_PCT=0.05
TRI_POLL_MS=3000
TRI_SYMBOL_COOLDOWN_MS=10000

# ---------- Laboratório (edge engine / paper trading) ----------
# O modo por defeito é PAPER TRADING: execução simulada com fills parciais,
# slippage conservador, TTL de sinal e explainability. LIVE só com --live.
# Preset: conservative | balanced | research (research = só análise de sinais)
CONFIG_PRESET=balanced
# RESEARCH_MODE=true só mede qualidade de sinais — nunca executa nada
RESEARCH_MODE=false
# RECORD_MARKET_DATA=true grava order books em data/frames-*.jsonl para replay
RECORD_MARKET_DATA=false
DATA_FRESHNESS_MS=3000
DATA_DEGRADED_MS=10000
DATA_OFFLINE_MS=30000
MIN_DATA_QUALITY=50
OPPORTUNITY_TTL_MS=4000
BASE_EDGE_BPS=5
EXECUTION_BUFFER_BPS=3
SAFETY_BUFFER_PCT=0.02
LAB_MIN_NET_USD=0.03
MIN_FILL_PROBABILITY=0.4
MAX_VOLATILITY_BPS=120
MAX_SLIPPAGE_BPS=40
MAX_LATENCY_MS=8000
MAX_DATA_AGE_MS=8000
MAX_SIMULTANEOUS_SIMULATIONS=4
MAX_DAILY_SIMULATED_LOSS_USD=20
EXCHANGE_OFFLINE_MS=60000
REGIME_HIGH_VOL_BPS=40
REGIME_EXTREME_VOL_BPS=100
REGIME_DISLOCATED_PCT=1.5
REGIME_LOW_LIQ_FACTOR=0.25

# ---------- Gestão de risco (circuit breakers) ----------
MAX_DAILY_LOSS_USD=10
MAX_OPEN_NOTIONAL_USD=500
MAX_CONSECUTIVE_FAILURES=3
STALE_DATA_MS=5000
KILL_SWITCH_FILE=./STOP
MAX_TRADES_PER_HOUR=30

# ---------- Painel web (opcional; obrigatório em hosting na nuvem) ----------
# PORT>0 liga um painel HTTP com P&L (gráfico), posições, trades, histórico de
# oportunidades, /health e /api/status. Com WEB_TOKEN podes Parar/Retomar e
# editar configuração em runtime (guardada em data/overrides.json):
# abre http://host:PORT/?token=<WEB_TOKEN>
PORT=8080
WEB_TOKEN=
# login do painel (opcional): com ADMIN_PASSWORD definida, / pede login de sessão
ADMIN_USER=admin
ADMIN_PASSWORD=

# ---------- Day trade direcional (operações 5-30 min, estilo payout fixo) ----------
# megabrain de confluência (RSI/EMA/MACD/Bollinger/momentum/velas/order-book)
# decide CALL/PUT por símbolo; vitória = +stake*DAYTRADE_PAYOUT_PCT, derrota = -stake.
# Em PAPER a resolução é simulada; em LIVE executa spot real.
DAYTRADE_ENABLED=true
DAYTRADE_EXCHANGE=
DAYTRADE_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,XRP/USDT,DOGE/USDT,AVAX/USDT,LINK/USDT,SUI/USDT
DAYTRADE_STAKE_USD=10
DAYTRADE_PAYOUT_PCT=0.9
DAYTRADE_EXPIRY_MINUTES=15
DAYTRADE_EXPIRY_MIN_MINUTES=5
DAYTRADE_EXPIRY_MAX_MINUTES=30
DAYTRADE_POLL_MS=15000
DAYTRADE_MAX_OPEN=3
DAYTRADE_MIN_SCORE=0.25
DAYTRADE_MIN_AGREEMENT=0.5
DAYTRADE_COOLDOWN_MS=300000
DAYTRADE_DAILY_LOSS_LIMIT_USD=30

# ---------- Alertas Telegram (opcional) ----------
# Cria um bot com @BotFather, obtém o chat_id com @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REPORT_EVERY_MIN=60
